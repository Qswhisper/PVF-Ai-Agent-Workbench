{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.pvf-agent-workbench/schemas/pvf-change-set.schema.json",
  "title": "Portable PVF Agent Workbench dry-run change-set",
  "type": "object",
  "required": [
    "schemaVersion",
    "mode",
    "target",
    "changes",
    "safety"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "mode": {
      "const": "dry-run-only"
    },
    "description": {
      "type": "string"
    },
    "baseline": {
      "type": "object",
      "required": [
        "applyManifest"
      ],
      "additionalProperties": false,
      "properties": {
        "applyManifest": {
          "type": "string",
          "minLength": 1,
          "description": "Optional previous successful APPLY-MANIFEST.json. Its unchanged, readback-successful output becomes this change-set input while target.sourcePvf remains the original protected source."
        }
      }
    },
    "target": {
      "type": "object",
      "required": [
        "sourcePvf"
      ],
      "additionalProperties": false,
      "properties": {
        "profile": {
          "type": "string"
        },
        "sourcePvf": {
          "type": "string",
          "minLength": 1
        },
        "pvfOpenEncoding": {
          "enum": [
            "Tw",
            "Cn",
            "Kr",
            "Jp",
            "Utf8",
            "Unicode"
          ]
        },
        "pvfReadEncoding": {
          "enum": [
            "Tw",
            "Cn",
            "Kr",
            "Jp",
            "Utf8",
            "Unicode"
          ]
        }
      }
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/replaceTextChange"
          },
          {
            "$ref": "#/$defs/writeFileChange"
          }
        ]
      }
    },
    "safety": {
      "type": "object",
      "required": [
        "writeModeEnabled",
        "requiresBackupBeforeApply",
        "requiresExplicitOutputPath",
        "requiresReadback"
      ],
      "additionalProperties": false,
      "properties": {
        "writeModeEnabled": {
          "const": false
        },
        "requiresBackupBeforeApply": {
          "const": true
        },
        "requiresExplicitOutputPath": {
          "const": true
        },
        "requiresReadback": {
          "const": true
        }
      }
    }
  },
  "$defs": {
    "replaceTextChange": {
      "type": "object",
      "required": [
        "id",
        "type",
        "pvfPath",
        "previousText",
        "newText"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "type": {
          "const": "replace-text"
        },
        "pvfPath": {
          "type": "string",
          "minLength": 1
        },
        "previousText": {
          "type": "string",
          "minLength": 1
        },
        "newText": {
          "type": "string"
        },
        "contextBefore": {
          "type": "string",
          "minLength": 1,
          "description": "Optional exact text immediately before previousText. It selects the location but is not replaced. It must not contain previousText."
        },
        "contextAfter": {
          "type": "string",
          "minLength": 1,
          "description": "Optional exact text immediately after previousText. It selects the location but is not replaced. It must not contain previousText."
        },
        "scope": {
          "type": "object",
          "required": [
            "startText",
            "endText",
            "expectedRanges"
          ],
          "additionalProperties": false,
          "description": "Optional exact range selector copied from the same raw target readback. Matches and adjacent context must remain inside the declared non-overlapping range(s); boundary markers are never writable.",
          "properties": {
            "startText": {
              "type": "string",
              "minLength": 1
            },
            "endText": {
              "type": "string",
              "minLength": 1
            },
            "expectedRanges": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "replaceAll": {
          "type": "boolean",
          "default": false,
          "description": "Replace every exact occurrence only when expectedOccurrences declares the exact positive count."
        },
        "expectedOccurrences": {
          "type": "integer",
          "minimum": 1,
          "description": "Required when replaceAll=true; actual occurrences must match exactly."
        },
        "textWriteMode": {
          "enum": [
            "verified-inline-text",
            "verified-inline-cn"
          ],
          "description": "Use only for one complete visible backtick token, including a multiline token. Keep parameter/structure edits as separate ordinary replace-text changes on the same pvfPath. Change array order is semantic when a later structure deletion depends on the verified text result."
        },
        "pvfEncoding": {
          "enum": [
            "Tw",
            "Cn",
            "Kr",
            "Jp",
            "Utf8",
            "Unicode"
          ]
        },
        "rationale": {
          "type": "string"
        },
        "requiredResolvedIds": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "lstPath",
              "id",
              "expectedPvfPath"
            ],
            "additionalProperties": false,
            "properties": {
              "lstPath": {
                "type": "string"
              },
              "id": {
                "type": "integer"
              },
              "expectedPvfPath": {
                "type": "string"
              }
            }
          }
        },
        "writeProof": {
          "$ref": "#/$defs/writeProof"
        }
      }
    },
    "writeFileChange": {
      "type": "object",
      "required": [
        "id",
        "type",
        "pvfPath",
        "sourceFile",
        "sourceSha256",
        "expectAbsent"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "type": {
          "const": "write-file"
        },
        "pvfPath": {
          "type": "string",
          "minLength": 1
        },
        "sourceFile": {
          "type": "string",
          "minLength": 1
        },
        "sourceSha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "expectAbsent": {
          "const": true
        },
        "compileScript": {
          "type": "boolean",
          "default": true
        },
        "compileBinaryAni": {
          "type": "boolean",
          "default": true
        },
        "pvfEncoding": {
          "enum": [
            "Tw",
            "Cn",
            "Kr",
            "Jp",
            "Utf8",
            "Unicode"
          ]
        },
        "rationale": {
          "type": "string"
        },
        "requiredResolvedIds": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "lstPath",
              "id",
              "expectedPvfPath"
            ],
            "additionalProperties": false,
            "properties": {
              "lstPath": {
                "type": "string"
              },
              "id": {
                "type": "integer"
              },
              "expectedPvfPath": {
                "type": "string"
              }
            }
          }
        },
        "writeProof": {
          "$ref": "#/$defs/writeProof"
        }
      }
    },
    "writeProof": {
      "type": "object",
      "required": ["mode"],
      "additionalProperties": false,
      "description": "受控高风险新增文件或登记表生命周期证据。工作台会在目标 PVF 内重新检查，不能只凭声明放行。",
      "properties": {
        "mode": {
          "enum": ["worldmap-lifecycle", "registry-lifecycle", "script-new-file", "localization-new-file"]
        },
        "allowExistingRegistryEdit": { "type": "boolean" },
        "registry": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "lstPath": { "type": "string", "minLength": 1 },
            "id": { "type": "integer" },
            "expectedPvfPath": { "type": "string", "minLength": 1 },
            "action": { "enum": ["add", "reuse", "verify"] }
          }
        },
        "pairedEntries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "pvfPath"],
            "properties": {
              "kind": { "enum": ["ui", "town-gate", "region-town", "registry", "dungeon"] },
              "pvfPath": { "type": "string", "minLength": 1 },
              "worldmapId": { "type": "integer" },
              "townId": { "type": "integer" },
              "dungeonIds": { "type": "array", "items": { "type": "integer" } },
              "required": { "type": "boolean" }
            }
          }
        },
        "referencePaths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "compileRequired": { "type": "boolean" },
        "encodingRoundTripRequired": { "type": "boolean" },
        "pvfEncoding": { "enum": ["Cn", "Tw", "Kr", "Jp", "Utf8", "Unicode"] },
        "sourceTextSha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "crossVersionEvidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "pvfSha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
              "pvfPath": { "type": "string" },
              "note": { "type": "string" }
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "script-new-file" } }, "required": ["mode"] },
          "then": {
            "required": ["compileRequired", "referencePaths"],
            "properties": {
              "compileRequired": { "const": true },
              "referencePaths": { "minItems": 1 }
            }
          }
        },
        {
          "if": { "properties": { "mode": { "const": "localization-new-file" } }, "required": ["mode"] },
          "then": {
            "required": ["pvfEncoding", "encodingRoundTripRequired", "referencePaths"],
            "properties": {
              "pvfEncoding": { "enum": ["Cn", "Tw"] },
              "encodingRoundTripRequired": { "const": true },
              "referencePaths": { "minItems": 1 }
            }
          }
        },
        {
          "if": { "properties": { "mode": { "const": "registry-lifecycle" } }, "required": ["mode"] },
          "then": {
            "required": ["registry"],
            "properties": {
              "registry": { "required": ["lstPath", "action"] }
            }
          }
        },
        {
          "if": { "properties": { "allowExistingRegistryEdit": { "const": true } }, "required": ["allowExistingRegistryEdit"] },
          "then": {
            "properties": {
              "registry": {
                "required": ["lstPath", "id", "expectedPvfPath", "action"],
                "properties": { "action": { "const": "add" } }
              }
            }
          }
        },
        {
          "if": { "properties": { "mode": { "const": "worldmap-lifecycle" } }, "required": ["mode"] },
          "then": {
            "required": ["registry", "pairedEntries"],
            "properties": {
              "registry": {
                "required": ["lstPath", "id", "expectedPvfPath", "action"],
                "properties": {
                  "lstPath": { "const": "worldmap/worldmap.lst" },
                  "action": { "const": "add" }
                }
              },
              "pairedEntries": {
                "minItems": 3,
                "allOf": [
                  { "contains": { "properties": { "kind": { "const": "ui" } }, "required": ["kind"] }, "minContains": 1 },
                  { "contains": { "properties": { "kind": { "const": "town-gate" } }, "required": ["kind"] }, "minContains": 1 },
                  { "contains": { "properties": { "kind": { "const": "region-town" } }, "required": ["kind"] }, "minContains": 1 }
                ]
              }
            }
          }
        }
      ]
    }
  }
}
