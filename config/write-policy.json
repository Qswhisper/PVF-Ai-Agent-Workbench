{
  "schemaVersion": "1.0",
  "phase": "phase-3-controlled-output-apply",
  "mode": "controlled-output-only",
  "publicWriteToolsEnabled": false,
  "controlledApplyEnabled": true,
  "permissionModel": {
    "readOnlyAdapter": "config/pvf-adapter.json launches only the Workbench-bundled read backend for ordinary inspection.",
    "controlledWriteRunner": "core/pvf-agent-core/cli/pvf-change-set.js is the only local PVF-generation lane. It may call bundled backend write operations during apply with explicit output, a SHA256-verified content-addressed protected-source backup promoted as the immutable source anchor, readback, and final-output SHA256 binding; an identical protected-source anchor is reused only after its hash is rechecked. Exact-range scope selectors bind marker hashes, non-overlapping range locations and content hashes without allowing boundary writes. A cumulative next round must explicitly bind the previous successful apply manifest. verified-inline-text, same-PVF ordinary-text copy, and existing-nut-controlled-edit dry-runs may additionally create and delete an isolated temporary output for proof. Same-PVF copy binds the complete source text, requires a new same-extension target, rejects protected high-risk extensions, and is modified only in a cumulative next round. Existing NUT controlled edits must use byte-preserving local ASCII replacement, require load paths as executable function-call arguments, never whole-file re-encoding, prove every non-target raw byte unchanged, and independently verify the temporary and final raw-content SHA256 after reopening. Client installation remains a separate client-pvf lane; that lane may replace a profiled live client-origin path only after the anchor is verified.",
    "hostExposedWriteToolsEnabled": false,
    "sourceOverwriteAllowed": false,
    "clientWriteAllowed": false
  },
  "controlledWriteRunner": {
    "serverCapability": {
      "environmentVariable": "PVF_WORKBENCH_SERVER_MODE",
      "value": "controlled-write"
    },
    "capabilityRegistry": {
      "schemaVersion": "1.0",
      "registryId": "pvf-change-controlled-write-capabilities",
      "runtimeResolver": "core/pvf-agent-core/lib/controlled-write-capabilities.js",
      "publicSchema": "core/pvf-agent-core/schemas/pvf-change-set.schema.json",
      "defaultDecision": "blocked",
      "permissionExpansionAllowed": false,
      "capabilityIds": [
        "ordinary-raw-token-replacement",
        "verified-inline-text",
        "existing-binary-ani-delay",
        "existing-nut-controlled-edit",
        "registry-lifecycle-row-add",
        "same-pvf-file-copy",
        "ordinary-new-file",
        "high-risk-new-file",
        "upgrade-amplification-table"
      ]
    },
    "executionPlanContract": {
      "schemaVersion": "1.1",
      "planId": "pvf-change-controlled-execution-plan",
      "runtimeModule": "core/pvf-agent-core/lib/controlled-execution-plan.js",
      "defaultDecision": "blocked",
      "permissionExpansionAllowed": false,
      "dryRunProducesBoundPlan": true,
      "applyRecomputesBeforeWrite": true,
      "replacementWriterConsumesPreflightPlan": true
    },
    "verifiedTextEligibilityContract": {
