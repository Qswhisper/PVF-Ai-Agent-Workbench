{
  "schemaVersion": "1.0",
  "phase": "phase-3-controlled-output-apply",
  "mode": "controlled-output-only",
  "publicWriteToolsEnabled": false,
  "controlledApplyEnabled": true,
  "permissionModel": {
    "readOnlyAdapter": "config/pvf-adapter.json launches only the Workbench-bundled read backend for ordinary inspection.",
    "controlledWriteRunner": "core/pvf-agent-core/cli/pvf-change-set.js is the only local PVF-generation lane; it may call bundled backend write operations only inside apply, only with explicit output, backup, readback, and final-output SHA256 binding. Client installation remains a separate client-pvf lane.",
    "hostExposedWriteToolsEnabled": false,
    "sourceOverwriteAllowed": false,
    "clientWriteAllowed": false
  },
  "controlledWriteRunner": {
    "serverCapability": {
      "environmentVariable": "PVF_WORKBENCH_SERVER_MODE",
      "value": "controlled-write"
    },
    "semanticTextSafety": {
      "automaticCnReadGuardRequired": true,
      "cnStrWriteAllowed": false,
      "directNonAsciiTextWriteAllowed": false,
      "numericOrAsciiMinimalWriteAllowed": true,
      "clientTextSmokeCheckRequired": true
    },
    "allowedBridgeTools": [
      "pvf_open",
      "pvf_list_files",
      "pvf_read_file",
      "pvf_resolve_lst_id",
      "pvf_replace_text",
      "pvf_write_file",
      "pvf_backup",
      "pvf_save",
      "pvf_close"
    ],
    "sourceOverwriteAllowed": false,
    "clientWriteAllowed": false,
    "requiresDryRunFirst": true,
    "requiresMatchingDryRunManifest": true,
    "requiresExplicitAuthorizationCode": true
  },
  "allowedOperations": [
    "validate-change-set",
    "dry-run-replace-text",
    "dry-run-write-new-file",
    "apply-replace-text-to-explicit-output",
    "apply-write-new-file-to-explicit-output"
  ],
  "forbiddenOperations": [
    "overwrite-source-pvf",
    "client-resource-write",
    "apply-without-backup",
    "apply-without-explicit-output",
    "apply-without-readback",
    "apply-without-matching-dry-run",
    "apply-without-explicit-authorization-code",
    "direct-cn-str-write",
    "direct-non-ascii-text-write"
  ],
  "requiredBeforeApply": [
    "explicit-user-authorization",
    "matching-dry-run-manifest",
    "target-pvf-confirmed",
    "timestamped-backup",
    "explicit-output-path",
    "readback-after-save"
  ],
  "requiredAfterApply": [
    "full-output-sha256-binding",
    "output-byte-size-binding"
  ],
  "outputs": {
    "dryRunRoot": "workspaces/dry-runs",
    "applyRoot": "workspaces/apply-runs",
    "dryRunManifestFileName": "DRY-RUN-MANIFEST.json",
    "applyManifestFileName": "APPLY-MANIFEST.json",
    "outputFileName": "Script.pvf"
  }
}
