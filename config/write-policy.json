{
  "schemaVersion": "1.0",
  "phase": "phase-3-controlled-output-apply",
  "mode": "controlled-output-only",
  "publicWriteToolsEnabled": false,
  "controlledApplyEnabled": true,
  "permissionModel": {
    "readOnlyAdapter": "config/pvf-adapter.json launches only the Workbench-bundled read backend for ordinary inspection.",
    "controlledWriteRunner": "core/pvf-agent-core/cli/pvf-change-set.js is the only local PVF-generation lane. It may call bundled backend write operations during apply with explicit output, a SHA256-verified content-addressed protected-source backup, readback, and final-output SHA256 binding; an identical protected-source backup is reused only after its hash is rechecked. Exact-range scope selectors bind marker hashes, non-overlapping range locations and content hashes without allowing boundary writes. A cumulative next round must explicitly bind the previous successful apply manifest. verified-inline-text dry-run may additionally create and delete an isolated temporary output for encoding proof. Client installation remains a separate client-pvf lane.",
    "hostExposedWriteToolsEnabled": false,
    "sourceOverwriteAllowed": false,
    "clientWriteAllowed": false
  },
  "controlledWriteRunner": {
    "serverCapability": {
      "environmentVariable": "PVF_WORKBENCH_SERVER_MODE",
      "value": "controlled-write"
    },
    "semanticTextSafety": {
      "automaticEncodingConflictGuardRequired": true,
      "cnStrWriteAllowed": false,
      "unverifiedDirectNonAsciiTextWriteAllowed": false,
      "verifiedInlineTextWriteAllowed": true,
      "verifiedInlineTextMultilineAllowed": true,
      "verifiedInlineTextBatchRequiresExactExpectedOccurrences": true,
      "exactAdjacentContextAnchoringAllowed": true,
      "contextAnchorDoesNotRelaxTextSafety": true,
      "exactRangeScopeAllowed": true,
      "scopeBoundaryRewriteAllowed": false,
      "scopeEvidenceBoundToDryRunAndApply": true,
      "sameFileChangesPlannedAsOneFinalText": true,
      "sameFileChangeOrderPreservedWhenRequired": true,
      "sameFileVerifiedInlineTextAppliedAsOneBatch": true,
      "stringTableAppendedOncePerVerifiedFileBatch": true,
      "stringLinkTextWriteAllowed": false,
      "cnAndTwRoundTripProbeRequired": true,
      "numericOrAsciiMinimalWriteAllowed": true,
      "rawTokenFileTypePolicy": "audited-explicit-allowlist",
      "auditedCanonicalConfigurationExtensions": [
        ".cre",
        ".npc",
        ".msn",
        ".wdm",
        ".twn",
        ".rgn",
        ".mm"
      ],
      "protectedNewWorldmapExtensions": [
        ".wdm"
      ],
      "protectedLogicRegistryAndLocalizationExtensions": [
        ".co",
        ".lst",
        ".nut",
        ".sqr",
        ".str"
      ],
      "highRiskNewFileProofRequired": true,
      "highRiskNewFileRoundTripProbeRequired": true,
      "highRiskFinalIndependentReadbackRequired": true,
      "highRiskSameExtensionReferenceRequired": true,
      "existingHighRiskFileProtectionRemains": true,
      "registryLifecycleOnlyForExplicitRowAdd": true,
      "registryLifecycleExistingTextPreserved": true,
      "registryLifecycleTargetClosureRequired": true,
      "worldmapLifecycleRequiresRegistryUiDungeonTownRegionClosure": true,
      "worldmapLifecycleRequiresBothTownAndRegion": true,
      "clientTextSmokeCheckRequired": true
    },
    "allowedBridgeTools": [
      "pvf_open",
      "pvf_list_files",
      "pvf_read_file",
      "pvf_resolve_lst_id",
      "pvf_replace_text",
      "pvf_apply_text_plan",
      "pvf_apply_verified_text_plan",
      "pvf_write_file",
      "pvf_save",
      "pvf_close"
    ],
    "sourceOverwriteAllowed": false,
    "clientWriteAllowed": false,
    "requiresDryRunFirst": true,
    "requiresMatchingDryRunManifest": true,
    "requiresExplicitAuthorizationCode": true,
    "contentAddressedSourceBackupRequired": true,
    "existingSourceBackupSha256RecheckRequired": true
  },
  "allowedOperations": [
    "validate-change-set",
    "dry-run-replace-text",
    "dry-run-verified-inline-text",
    "dry-run-write-new-file",
    "apply-replace-text-to-explicit-output",
    "apply-verified-inline-text-to-explicit-output",
    "apply-write-new-file-to-explicit-output"
  ],
  "forbiddenOperations": [
    "overwrite-source-pvf",
    "client-resource-write",
    "apply-without-backup",
    "apply-without-explicit-output",
    "apply-without-readback",
    "apply-without-matching-dry-run",
    "apply-without-explicit-authorization-code",
    "undeclared-cumulative-baseline-assumption",
    "direct-cn-str-write",
    "unverified-direct-non-ascii-text-write",
    "direct-stringlink-text-write"
  ],
  "requiredBeforeApply": [
    "explicit-user-authorization",
    "matching-dry-run-manifest",
    "verified-cumulative-baseline-chain-when-declared",
    "target-pvf-confirmed",
    "verified-content-addressed-source-backup",
    "explicit-output-path",
    "readback-after-save"
  ],
  "requiredAfterApply": [
    "full-output-sha256-binding",
    "output-byte-size-binding"
  ],
  "outputs": {
    "dryRunRoot": "workspaces/dry-runs",
    "applyRoot": "workspaces/apply-runs",
    "dryRunManifestFileName": "DRY-RUN-MANIFEST.json",
    "applyManifestFileName": "APPLY-MANIFEST.json",
    "outputFileName": "Script.pvf"
  }
}
