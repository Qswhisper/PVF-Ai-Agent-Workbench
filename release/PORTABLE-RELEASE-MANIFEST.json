{
  "$schema": "../core/pvf-agent-core/schemas/portable-release-manifest.schema.json",
  "schemaVersion": "1.0",
  "phase": "agent-workspace-portable-release",
  "packageName": "PVF-Agent-Workbench",
  "packageVersion": "3.1.0",
  "purpose": "Portable self-contained PVF Agent workspace with beginner-first progressive responses, automatic Cn/Tw encoding-conflict protection, round-trip-verified multiline, exact-count batch, and hash-bound exact-range-scoped inline Chinese text changes, dependency-aware same-file ordering with one-pass verified-text batching, explicit cumulative apply chains, reusable SHA256-verified protected-source backups, external persistent local profiles, target-bound skill and script routing, a preferred native backend, a bundled dependency-free TypeScript read-only fallback, SHA-bound indexes, controlled output, client-origin source promotion after verified backup, baseline-safe separately authorized test-client Script.pvf deployment and rollback, clean knowledge routing, Agent Skill, release gates, and deterministic evaluations.",
  "portableCore": {
    "include": [
      ".gitattributes",
      ".gitignore",
      "LICENSE",
      "LICENSE-KNOWLEDGE-CC0.md",
      "VERSION",
      "CHANGELOG.zh-CN.md",
      "AGENTS.md",
      ".agents/",
      "README.md",
      "README.zh-CN.md",
      "workbench.bat",
      "agents/",
      "commands/",
      "config/",
      "core/",
      "docs/",
      "evals/",
      "knowledge-pack/",
      "release/",
      "runtime/node/node.exe",
      "runtime/node/LICENSE",
      "tools/",
      "workspaces/README.zh-CN.md",
      "workspaces/absorption-checklists/README.zh-CN.md",
      "workspaces/agent-eval-runs/README.zh-CN.md",
      "workspaces/doctor-runs/README.zh-CN.md",
      "workspaces/examples/",
      "workspaces/indexes/README.zh-CN.md",
      "workspaces/package-dry-runs/README.zh-CN.md",
      "workspaces/planner-runs/README.zh-CN.md",
      "workspaces/release-runs/README.zh-CN.md"
    ]
  },
  "exclude": {
    "localPrivate": [
      "config/providers.local.json",
      "config/workspace-profiles.local.json",
      "config/*.secret.json"
    ],
    "generatedOutputs": [
      "workspaces/dry-runs/",
      "workspaces/apply-runs/",
      "workspaces/backend-contract-runs/",
      "workspaces/backend-fixture-runs/",
      "workspaces/first-run-reports/",
      "workspaces/real-task-runs/",
      "workspaces/real-task-checks/",
      "workspaces/absorption-checklists/",
      "workspaces/agent-eval-runs/",
      "workspaces/agent-workspace-stages/",
      "workspaces/runtime-overlay-dry-runs/",
      "workspaces/runtime-overlay-stages/",
      "workspaces/stage-copy-dry-runs/",
      "workspaces/cold-start-dry-runs/",
      "workspaces/doctor-runs/",
      "workspaces/planner-runs/",
      "workspaces/package-dry-runs/",
      "workspaces/release-runs/",
      "workspaces/indexes/"
    ],
    "mountedUserData": [
      "real PVF paths",
      "client paths",
      "task source materials",
      "machine-specific profiles"
    ],
    "heavyArtifacts": [
      "*.pvf",
      "*.bak",
      "*.npk",
      "*.img",
      "*.zip",
      "*.7z",
      "*.rar"
    ]
  },
  "validation": {
    "environment": "workbench.bat check",
    "knowledgePack": "workbench.bat knowledge-check",
    "controlledChange": "workbench.bat pvf-change self-test",
    "agentEval": "workbench.bat eval self-test",
    "agentSkill": "workbench.bat skill self-test",
    "workspaceProfiles": "workbench.bat profile self-test",
    "clientPvfDeployment": "workbench.bat client-pvf self-test",
    "knowledgeQuery": "workbench.bat knowledge-query self-test",
    "readOnlyFallback": "workbench.bat fallback-self-test",
    "doctor": "workbench.bat doctor check --skip-profiles",
    "gate1": "workbench.bat release gate1",
    "gate2": "workbench.bat release gate2",
    "gate3": "workbench.bat release gate3"
  },
  "runtimeIntegrity": "release/BUNDLED-RUNTIME-MANIFEST.json",
  "safety": {
    "defaultMode": "read-only",
    "sourcePvfOverwriteAllowed": false,
    "clientResourceWriteAllowedByDefault": false,
    "readOnlyFallbackWriteAllowed": false,
    "semanticEncodingConflictGuardAutomatic": true,
    "verifiedInlineTextCnAndTwWriteAllowed": true,
    "verifiedInlineTextRequiresIsolatedRoundTripAndExactIndependentReadback": true,
    "verifiedInlineTextTitlebookSendPostalExactPathOnly": true,
    "verifiedInlineTextMultilineAllowed": true,
    "verifiedInlineTextBatchRequiresExactExpectedOccurrences": true,
    "exactAdjacentContextAnchoringAllowed": true,
    "contextAnchorDoesNotRelaxTextSafety": true,
    "exactRangeScopeAllowed": true,
    "scopeBoundaryRewriteAllowed": false,
    "scopeEvidenceBoundToDryRunAndApply": true,
    "sameFileChangesPlannedAsOneFinalText": true,
    "sameFileChangeOrderPreservedWhenRequired": true,
    "sameFileVerifiedInlineTextAppliedAsOneBatch": true,
    "stringTableAppendedOncePerVerifiedFileBatch": true,
    "contentAddressedSourceBackupRequired": true,
    "existingSourceBackupSha256RecheckRequired": true,
    "cumulativeApplyManifestBindingRequiredForNextRoundDelta": true,
    "samePvfOrdinaryTextCopyRequiresAbsentSameExtensionTarget": true,
    "samePvfOrdinaryTextCopyBlocksHighRiskExtensions": true,
    "samePvfCopyModificationRequiresCumulativeNextRound": true,
    "integerDecimalReplacementRequiresCompleteTagAndExactValue": true,
    "localProfilesStoredOutsideWorkbench": true,
    "legacyLocalProfileCopiedWithoutDeletion": true,
    "standaloneBridgeBackupExposedInControlledWrite": false,
    "unverifiedDirectNonAsciiTextWriteAllowed": false,
    "cnStrWriteAllowed": false,
    "stringLinkTextWriteAllowed": false,
    "fullIndexSourceSha256Bound": true,
    "realPvfRequiredForReleaseGates": false,
    "writeRequiresExplicitOutputBackupReadbackManifest": true,
    "controlledClientPvfDeploymentAvailable": true,
    "clientPvfDeploymentRequiresSeparatePreviewAuthorizationBackupAndRollback": true,
    "clientPvfDeploymentRequiresApplyInputBaselineContinuity": true,
    "clientOriginSourceRequiresVerifiedProtectedAnchorBeforeDeployment": true,
    "clientOriginSourceCanDeployWithoutManualCopy": true,
    "explicitClientBaselineSwitchRequiredForBranchChange": true,
    "nonPvfClientResourceWriteAllowed": false,
    "newWorldmapFileRequiresRegistryAndPairedEntryCheck": true,
    "highRiskNewFilesRequireSameExtensionReferenceAndIndependentReadback": true,
    "existingNutControlledEditRequiresDedicatedProof": true,
    "existingNutRawBytePreservingPatchRequired": true,
    "existingNutWholeFileReencodingAllowed": false,
    "existingNutNonTargetRawBytesMustRemainIdentical": true,
    "existingNutEvidenceMustBeExecutableCode": true,
    "existingNutApidMustBeExactIntegerLiteral": true,
    "existingNutApidMustBeDeclaredApiCallArgument": true,
    "existingNutRequiresTemporaryAndFinalIndependentReadback": true,
    "existingNutFinalRawByteSha256ReadbackRequired": true,
    "existingNutRuntimeValidationRequired": true,
    "registryLifecycleIsAddOnlyAndRequiresTargetClosure": true,
    "worldmapLifecycleRequiresBothRegisteredTownAndRegion": true
  }
}
