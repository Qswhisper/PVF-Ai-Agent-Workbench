{
  "schemaVersion": "1.0",
  "packageName": "PVF-Agent-Workbench",
  "packageVersion": "2.1.3",
  "purpose": "Self-contained clean workspace with automatic Cn semantic read protection, a preferred native PVF backend, a dependency-free TypeScript read-only fallback, SHA-bound indexes, bundled knowledge, and controlled output.",
  "includes": [
    ".gitattributes",
    ".gitignore",
    "AGENTS.md",
    "LICENSE",
    "LICENSE-KNOWLEDGE-CC0.md",
    "README.md",
    "README.zh-CN.md",
    "VERSION",
    "CHANGELOG.zh-CN.md",
    "workbench.bat",
    ".agents/skills/dnf-pvf-xpilot/",
    "commands/",
    "docs/",
    "release/",
    "config/pvf-adapter.json",
    "config/write-policy.json",
    "config/workspace-profiles.json",
    "core/pvf-agent-core/",
    "evals/agent/",
    "knowledge-pack/",
    "runtime/node/node.exe",
    "runtime/node/LICENSE",
    "tools/pvf-bridge/server.js",
    "tools/pvf-bridge/native-backend.js",
    "tools/pvf-bridge/fallback/",
    "tools/pvf-bridge/dungeon-workflow.js",
    "tools/pvf-bridge/extract-dungeon.js",
    "tools/pvf-bridge/import-dungeon-extract.js",
    "tools/pvf-bridge/package-dungeon-assets.js",
    "tools/pvf-bridge/compare-existing-dependencies.js",
    "tools/pvf-bridge/analyze-apc.js",
    "tools/pvf-bridge/plan-item-stackable-dependencies.js",
    "tools/pvf-bridge/pvf_graph_common.js",
    "tools/pvf-bridge/pvf-scope-planner.js",
    "tools/pvf-bridge/compare-dungeon-extracts.js",
    "tools/pvf-bridge/clean-client-compatible-extract.js",
    "tools/pvf-bridge/materialize-dungeon-preset.js",
    "tools/pvf-bridge/native/pvf_rust_core.node",
    "workspaces/examples/",
    "workspaces/absorption-checklists/README.zh-CN.md",
    "workspaces/agent-eval-runs/README.zh-CN.md",
    "workspaces/release-runs/README.zh-CN.md",
    "workspaces/planner-runs/README.zh-CN.md"
  ],
  "excludes": [
    "API keys",
    "real PVF files",
    "client files",
    "target-PVF generated indexes and caches",
    "generated reports",
    "OpenCode Desktop runtime",
    "roadmap / staging task documents",
    "backend evidence and historical candidate artifacts"
  ],
  "safety": {
    "defaultMode": "read-only",
    "sourcePvfOverwriteAllowed": false,
    "clientResourceWriteAllowedByDefault": false,
    "writeRequiresExplicitOutputBackupReadbackManifest": true,
    "readOnlyFallbackWriteAllowed": false,
    "semanticCnReadGuardAutomatic": true,
    "directNonAsciiTextWriteAllowed": false,
    "fullIndexSourceSha256Bound": true
  },
  "release": {
    "manifest": "release/PORTABLE-RELEASE-MANIFEST.json",
    "agentSkill": "workbench.bat skill self-test",
    "agentEval": "workbench.bat eval self-test",
    "knowledgeQuery": "workbench.bat knowledge-query self-test",
    "readOnlyFallback": "workbench.bat fallback-self-test",
    "gate1": "workbench.bat release gate1",
    "gate2": "workbench.bat release gate2",
    "gate3": "workbench.bat release gate3"
  }
}
