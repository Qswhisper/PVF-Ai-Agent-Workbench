        { "id": "no-inherit", "patterns": ["不能.{0,16}(说|写成).{0,12}版本 B.{0,12}(重新|也).{0,8}实机 PASS", "不自动继承.{0,8}PASS"] }
      ],
      "forbiddenPatterns": ["文件相同.{0,8}(所以|就).{0,8}版本 B.{0,8}(也|重新).{0,8}实机 PASS"]
