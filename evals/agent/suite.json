        { "id": "translation", "patterns": ["翻译.{0,12}(独立|分层).{0,12}(方法|版本)", "机翻.{0,12}不能.{0,8}(覆盖|伪装)"] },
        { "id": "tool-extension", "patterns": ["tool-extension.{0,12}(工具扩展|单独).{0,12}(不是|不能).{0,8}官方"] },
        { "id": "target", "patterns": ["目标 PVF.{0,16}(样本|读回|最近邻)"] }
