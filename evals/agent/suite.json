    {
      "id": "tag-observation-boundary",
      "title": "Tag 观察索引与目标 readback",
      "responseFile": "tag-observation-boundary.md",
      "prompt": "tag-knowledge 在目标 PVF 搜不到 [mystery tag]，是不是可以证明这个字段不存在？",
      "requiredGroups": [
        { "id": "zero", "patterns": ["0.{0,8}命中.{0,12}不.{0,8}证明.{0,8}不存在", "搜不到.{0,12}不能.{0,8}证明"] },
        { "id": "index", "patterns": ["观察.{0,8}(只是|属于).{0,8}索引", "generated index.{0,12}不是.{0,8}最终证据"] },
        { "id": "sha", "patterns": ["完整.{0,8}PVF SHA", "SHA256"] },
        { "id": "neighbor", "patterns": ["最近邻样本|目标目录.{0,12}同类样本|读回目标文件"] }
