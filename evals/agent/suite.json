        { "id": "candidate", "patterns": ["拼写候选|candidate", "tackable.{0,12}stackable.{0,12}候选"] },
        { "id": "not-fact", "patterns": ["不能.{0,12}(直接|成为).{0,12}registry.{0,8}事实", "工具提示.{0,12}不.{0,8}证明"] },
        { "id": "resolve", "patterns": ["目标 PVF.{0,16}\\.lst", "正确.{0,8}\\.lst.{0,8}(解析|核对)"] },
        { "id": "wown", "patterns": ["wown.{0,12}town"] }
      ],
      "forbiddenPatterns": ["tackable.{0,8}(就是|可直接作为).{0,8}registry", "wown.{0,8}(就是|可直接作为).{0,8}registry"]
